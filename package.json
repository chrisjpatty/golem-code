{
  "name": "golem-code",
  "private": true,
  "workspaces": ["packages/*"],
  "scripts": {
    "summon": "bun run packages/cli/src/index.ts",
    "test": "bun test packages/*/src/",
    "build": "bun run scripts/build.ts",
    "build:frontend": "cd packages/frontend && bun run build",
    "build:overlay": "cd packages/overlay && cargo build --release"
  },
  "devDependencies": {
    "bun-types": "^1.3.9",
    "typescript": "^5.9.3"
  }
}
