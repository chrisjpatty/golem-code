{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "[ -n \"$GOLEM_PORT\" ] && curl -s -o /dev/null -X POST http://localhost:$GOLEM_PORT/hook -H 'Content-Type: application/json' -d \"$(cat)\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
